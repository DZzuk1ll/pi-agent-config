  "repository": {
    "type": "git",
    "url": "git+https://github.com/spences10/my-pi.git",
    "directory": "packages/pi-redact"
  },
  "files": [
    "src",
    "dist",
    "README.md"
  ],
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
