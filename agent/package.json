{
  "name": "personal-pi-agent",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^24.15.0 || >=26.0.0"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --pretty false",
    "lint": "biome lint extensions tests vitest.config.ts",
    "lint:imports": "depcruise --config dependency-cruiser.config.js extensions tests",
    "check": "npm run typecheck && npm run lint && npm run lint:imports && npm test",
    "test": "npm run test:core && npm run test:extensions",
    "test:core": "node --test tests/*.test.ts",
    "test:extensions": "vitest run"
  },
  "dependencies": {
    "@personal-pi/child-env": "file:extensions/_shared/packages/child-env",
    "@personal-pi/config": "file:extensions/_shared/packages/config",
    "@personal-pi/project-trust": "file:extensions/_shared/packages/project-trust",
    "@personal-pi/redact": "file:extensions/_shared/packages/redact",
    "@personal-pi/settings": "file:extensions/_shared/packages/settings",
    "@personal-pi/sqlite-core": "file:extensions/_shared/packages/sqlite-core",
    "@personal-pi/tui-kit": "file:extensions/_shared/packages/tui-kit",
    "@personal-pi/tui-modal": "file:extensions/_shared/packages/tui-modal",
    "@pierre/diffs": "1.2.12",
    "@shikijs/cli": "4.3.1",
    "beautiful-mermaid": "1.1.3",
    "diff": "9.0.0",
    "jiti": "2.7.0",
    "mermaid": "11.16.0",
    "shiki": "4.3.1",
    "typebox": "1.1.38",
    "yaml": "2.8.3"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.6",
    "@earendil-works/pi-agent-core": "0.83.0",
    "@earendil-works/pi-ai": "0.83.0",
    "@earendil-works/pi-coding-agent": "0.83.0",
    "@earendil-works/pi-tui": "0.83.0",
    "@types/node": "^26.1.2",
    "dependency-cruiser": "18.1.1",
    "typescript": "5.9.3",
    "typescript-language-server": "5.3.0",
    "vitest": "^4.1.10"
  }
}
