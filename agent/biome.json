{
  "$schema": "https://biomejs.dev/schemas/2.5.6/schema.json",
  "formatter": {
    "enabled": false
  },
  "linter": {
    "enabled": true,
    "domains": {
      "types": "recommended"
    },
    "rules": {
      "recommended": true,
      "suspicious": {
        "noControlCharactersInRegex": "off",
        "noExplicitAny": "error",
        "noFocusedTests": "error"
      },
      "style": {
        "noNonNullAssertion": "error",
        "useNodejsImportProtocol": "warn",
        "useTemplate": "warn"
      },
      "complexity": {
        "noUselessStringRaw": "warn",
        "noUselessTernary": "warn",
        "useIndexOf": "warn",
        "useLiteralKeys": "warn"
      }
    }
  }
}
